    "autoload": {
        "psr-4": {
            "SGCart\\SocialShare\\": "src/"
        }
    },
    "authors": [
        {
            "name": "SGCart Team",
            "email": "support@sgcart.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SGCart\\SocialShare\\Providers\\SocialShareServiceProvider"
            ]
        }
    }
}
